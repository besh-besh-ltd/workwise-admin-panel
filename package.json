{
  "name": "des-tecnical-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env-cmd -f .env next dev",
    "start": "env-cmd -f .env next start ",
    "build": "env-cmd -f .env.development next build",
    "lint": "next lint",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@reduxjs/toolkit": "^2.2.0",
    "@tinymce/tinymce-react": "^6.0.0",
    "axios": "^1.7.0",
    "bootstrap": "^5.3.2",
    "chart.js": "^4.4.1",
    "env-cmd": "^10.1.0",
    "formik": "^2.4.5",
    "html-react-parser": "^5.2.8",
    "moment": "^2.30.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.0",
    "react-chartjs-2": "^5.2.0",
    "react-datepicker": "^7.0.0",
    "react-dom": "^19.0.0",
    "react-paginate": "^8.2.0",
